      "exit_condition": "deployment_successful",
      "skippable": false,
      "steps": [
        {
          "id": "pre_launch_validation",
          "name": "Pre-Launch Validation",
          "description": "Validate production readiness",
          "required_action": "validate_pre_launch",
          "user_input_required": false,
          "next_step": "production_deployment",
          "estimated_duration": "15m"
        },
        {
          "id": "production_deployment",
          "name": "Production Deployment",
          "description": "Deploy application to production",
          "required_action": "deploy_to_production",
          "user_input_required": false,
          "next_step": "deployment_verification",
          "estimated_duration": "30m"
        },
        {
          "id": "deployment_verification",
          "name": "Verify Deployment",
          "description": "Verify deployment success and health",
          "required_action": "verify_deployment",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "15m"
