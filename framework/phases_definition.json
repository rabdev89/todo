          "id": "eng_pi_readiness_audit",
          "name": "Audit PI Readiness (Eng Mode)",
          "description": "Final Tech Lead audit before UAT and release",
          "required_action": "eng_pi_readiness_audit",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "20m"
