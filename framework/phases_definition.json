          "user_input_required": false,
          "next_step": "deployment_checklist_generation",
          "estimated_duration": "15m"
        },
        {
          "id": "deployment_checklist_generation",
          "name": "Generate Deployment Checklist",
          "description": "Generate pre-launch checklist",
          "required_action": "generate_deployment_checklist",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "10m"
