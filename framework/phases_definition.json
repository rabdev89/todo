          "required_action": "trigger_swarm",
          "user_input_required": false,
          "next_step": "ticket_selection",
          "estimated_duration": "2m"
        },
        {
          "id": "ticket_selection",
          "name": "Select Next Ticket",
          "description": "Select next available ticket based on dependencies",
          "required_action": "select_next_ticket",
          "user_input_required": false,
          "next_step": "ticket_scoping",
          "estimated_duration": "30s"
        },
        {
          "id": "ticket_scoping",
          "name": "Scope Ticket",
          "description": "Scoping ticket through AI requirements and design generation",
          "required_action": "scope_ticket",
          "user_input_required": false,
          "next_step": "code_generation",
          "estimated_duration": "2m"
        },
        {
          "id": "code_generation",
          "name": "Generate Code",
          "description": "Generate implementation code for selected ticket",
          "required_action": "generate_code",
          "user_input_required": false,
          "next_step": "interactive_ui_verification",
          "estimated_duration": "20m"
        },
        {
          "id": "interactive_ui_verification",
          "name": "Interactive UI Verification (Agent Browsing)",
          "description": "Agent uses GStack /browse to interactively verify UI behavior and responsiveness",
          "required_action": "interactive_ui_verification",
          "user_input_required": false,
          "next_step": "code_review_ai",
          "estimated_duration": "10m"
        },
        {
          "id": "code_review_ai",
          "name": "AI Code Review",
          "description": "AI performs code review and quality checks",
          "required_action": "review_code",
          "user_input_required": false,
          "next_step": "expert_code_review",
          "estimated_duration": "10m"
        },
        {
          "id": "expert_code_review",
          "name": "Expert Code Review (Staff Eng)",
          "description": "Deep architectural and security review using GStack specialist",
          "required_action": "expert_code_review",
          "user_input_required": false,
          "next_step": "unit_test_generation",
          "estimated_duration": "15m"
        },
        {
          "id": "unit_test_generation",
          "name": "Generate Unit Tests",
          "description": "Generate unit tests for implemented code",
          "required_action": "generate_unit_tests",
          "user_input_required": false,
          "next_step": "unit_test_execution",
          "estimated_duration": "15m"
        },
        {
          "id": "unit_test_execution",
          "name": "Execute Unit Tests",
          "description": "Execute unit tests and validate results",
          "required_action": "run_tests",
          "user_input_required": false,
          "next_step": "visual_regression_qa",
          "estimated_duration": "5m"
        },
        {
          "id": "visual_regression_qa",
          "name": "Visual & Regression QA (QA Lead)",
          "description": "Diff-aware visual testing and regression check using GStack QA",
          "required_action": "visual_regression_qa",
          "user_input_required": false,
          "next_step": "ticket_selection",
          "estimated_duration": "10m"
        }
      ]
    },
    {
      "id": "epic_hardening",
      "name": "Epic Hardening",
      "description": "Ensure epics are stable and production-ready",
      "entry_condition": "development_complete",
      "exit_condition": "epics_validated",
      "skippable": true,
      "steps": [
        {
          "id": "integration_testing",
          "name": "Integration Testing",
          "description": "Test integrated features across components",
          "required_action": "run_integration_tests",
          "user_input_required": false,
          "next_step": "threat_modeling",
          "estimated_duration": "30m"
        },
        {
          "id": "threat_modeling",
          "name": "Threat Modeling",
          "description": "Analyze system boundaries and data flows for vulnerabilities",
          "required_action": "generate_threat_model",
          "user_input_required": false,
          "next_step": "api_locking",
          "estimated_duration": "30m"
        },
        {
          "id": "api_locking",
          "name": "API Contracts Locking",
          "description": "Finalize and freeze API contracts and database schema mappings",
          "required_action": "lock_api_contracts",
          "user_input_required": false,
          "next_step": "verification_gate",
          "estimated_duration": "30m"
        },
        {
          "id": "verification_gate",
          "name": "Verification Gate",
          "description": "Run strict quality and coverage checks",
          "required_action": "run_verification_gate",
          "user_input_required": false,
          "next_step": "bug_fix_cycle",
          "estimated_duration": "10m"
        },
        {
          "id": "bug_fix_cycle",
          "name": "Bug Fix Cycle",
          "description": "Fix discovered issues and regressions",
