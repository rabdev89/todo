        },
        {
          "id": "ship_epic",
          "name": "Ship Epic Branch",
          "description": "Final release engineering and PR synchronization",
          "required_action": "ship_epic",
          "user_input_required": false,
          "next_step": "knowledge_compression",
          "estimated_duration": "5m"
        },
        {
          "id": "knowledge_compression",
          "name": "Compress Epic Knowledge",
          "description": "Synthesize architectural decisions, patterns, and database changes from the completed epic into a concise summary and store in memory for future agent context",
          "required_action": "compress_epic_knowledge",
          "user_input_required": false,
          "next_step": "epic_retrospective",
          "estimated_duration": "5m"
        },
        {
          "id": "epic_retrospective",
          "name": "Epic Retrospective (EM Mode)",
          "description": "Analyze delivery metrics and capture lessons using GStack retro",
