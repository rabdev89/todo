          "required_action": "generate_deployment_scripts",
          "user_input_required": false,
          "next_step": "rollback_plan_creation",
          "estimated_duration": "30m"
        },
        {
          "id": "rollback_plan_creation",
          "name": "Create Rollback Plan",
          "description": "Create rollback strategy and procedures",
