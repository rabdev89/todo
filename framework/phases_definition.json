{
  "$schema": "./phases_definition.schema.json",
  "framework_version": "1.0.0",
  "description": "BOB - AI Software Development Workflow Framework - Phase Definitions",
  "phases": [
    {
      "id": "framework_bootstrap",
      "name": "Framework Bootstrap",
      "description": "Verify framework integrity before installation",
      "entry_condition": "repository_cloned",
      "exit_condition": "bootstrap_validated",
      "skippable": false,
      "steps": [
        {
          "id": "check_framework_setup",
          "name": "Validate Framework Setup",
          "description": "Run combined repository, version and diagnostics checks",
          "required_action": "validate_framework_setup",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "1m"
        }
      ]
    },
    {
      "id": "framework_installation",
      "name": "Framework Installation",
      "description": "Install and start framework tools",
      "entry_condition": "bootstrap_validated",
      "exit_condition": "framework_running",
      "skippable": false,
      "steps": [
        {
          "id": "framework_install",
          "name": "Install & Initialize Framework",
          "description": "Install dependencies, validate environment, run tests, generate health report, and start services (combined)",
          "required_action": "initialize_services",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "7m"
        }
      ]
    },
    {
      "id": "project_initialization",
      "name": "Project Initialization",
      "description": "Initialize project configuration",
      "entry_condition": "framework_running",
      "exit_condition": "project_initialized",
      "skippable": true,
      "steps": [
        {
          "id": "detect_project_type",
          "name": "Detect Project Type",
          "description": "Identify new, existing, or migration project and select templates",
          "required_action": "select_project_type",
          "user_input_required": false,
          "next_step": "initialize_management_structure",
          "estimated_duration": "15s"
        },
        {
          "id": "initialize_management_structure",
          "name": "Initialize Management Structure",
          "description": "Create project folders, ticket templates, and CI/verification stubs",
          "required_action": "generate_project_management_structure",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "30s"
        }
      ]
    },
    {
      "id": "product_definition",
      "name": "Product Definition",
      "description": "Define product vision and user flows",
      "entry_condition": "project_initialized",
      "exit_condition": "product_defined",
      "skippable": false,
      "steps": [
        {
          "id": "vision_generation",
          "name": "Generate Vision Document",
          "description": "Generate initial product vision document",
          "required_action": "generate_vision_document",
          "user_input_required": false,
          "next_step": "vision_review",
          "estimated_duration": "5m"
        },
        {
          "id": "vision_review",
          "name": "Review Vision",
          "description": "User reviews and approves product vision",
          "required_action": "user_review_vision",
          "user_input_required": false,
          "next_step": "user_flow_creation",
          "estimated_duration": "user_dependent"
        },
        {
          "id": "user_flow_creation",
          "name": "Create User Flow",
          "description": "Create user_flow.md with journey mapping",
          "required_action": "generate_user_flow",
          "user_input_required": false,
          "next_step": "user_flow_review",
          "estimated_duration": "10m"
        },
        {
          "id": "user_flow_review",
          "name": "Review User Flow",
          "description": "User reviews and approves user_flow.md",
          "required_action": "user_review_user_flow",
          "user_input_required": false,
          "next_step": "user_flow_validation",
          "estimated_duration": "user_dependent"
        },
        {
          "id": "user_flow_validation",
          "name": "Validate User Flow",
          "description": "Validate user flow logic and completeness",
          "required_action": "validate_user_flow",
          "user_input_required": false,
          "next_step": "requirements_alignment",
          "estimated_duration": "2m"
        },
        {
          "id": "requirements_alignment",
          "name": "Align Requirements",
          "description": "Generate PRD, FRD, and system architecture",
          "required_action": "generate_requirements",
          "user_input_required": false,
          "next_step": "generate_design_bible",
          "estimated_duration": "15m"
        },
        {
          "id": "generate_design_bible",
          "name": "Generate Design Bible",
          "description": "Suggest 3 design directions and generate preview templates",
          "required_action": "generate_design_bible",
          "user_input_required": false,
          "next_step": "approve_design_bible",
          "estimated_duration": "15m"
        },
        {
          "id": "approve_design_bible",
          "name": "Approve Design Bible",
          "description": "User selects preferred design direction to finalize style guide",
          "required_action": "approve_design_bible",
          "user_input_required": false,
          "next_step": "requirements_review",
          "estimated_duration": "user_dependent"
        },
        {
          "id": "requirements_review",
          "name": "Review Requirements",
          "description": "User reviews and approves all logic requirements",
          "required_action": "user_review_requirements",
          "user_input_required": false,
          "next_step": "ceo_product_audit",
          "estimated_duration": "user_dependent"
        },
        {
          "id": "ceo_product_audit",
          "name": "Audit Product Strategy (CEO Mode)",
          "description": "Founder-level audit of vision, user flow, and requirements alignment",
          "required_action": "ceo_product_audit",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "10m"
        }
      ]
    },
    {
      "id": "technical_architecture",
      "name": "Technical Architecture",
      "description": "Define system architecture and technical stack",
      "entry_condition": "product_defined",
      "exit_condition": "architecture_defined",
      "skippable": false,
      "steps": [
        {
          "id": "architecture_design",
          "name": "Design Architecture",
          "description": "Generate system architecture design",
          "required_action": "generate_architecture_design",
          "user_input_required": false,
          "next_step": "generate_tech_stack",
          "estimated_duration": "10m"
        },
        {
          "id": "generate_tech_stack",
          "name": "Generate Tech Stack",
          "description": "Detect existing technology stack and dependencies",
          "required_action": "generate_tech_stack",
          "user_input_required": false,
          "next_step": "generate_project_context",
          "estimated_duration": "30s"
        },
        {
          "id": "generate_project_context",
          "name": "Generate Project Context",
          "description": "Create tech_stack.json, project metadata, and environment configs",
          "required_action": "generate_project_context",
          "user_input_required": false,
          "next_step": "tech_stack_validation",
          "estimated_duration": "1m"
        },
        {
          "id": "tech_stack_validation",
          "name": "Validate Tech Stack",
          "description": "Validate and confirm tech stack compatibility",
          "required_action": "validate_tech_stack",
          "user_input_required": false,
          "next_step": "database_schema_planning",
          "estimated_duration": "5m"
        },
        {
          "id": "database_schema_planning",
          "name": "Plan Database Schema",
          "description": "Design database schema and relationships",
          "required_action": "generate_database_schema",
          "user_input_required": false,
          "next_step": "api_contract_definition",
          "estimated_duration": "10m"
        },
        {
          "id": "api_contract_definition",
          "name": "Define API Contracts",
          "description": "Define API structure and contracts",
          "required_action": "generate_api_contracts",
          "user_input_required": false,
          "next_step": "eng_arch_audit",
          "estimated_duration": "10m"
        },
        {
          "id": "eng_arch_audit",
          "name": "Audit Technical Architecture (Eng Mode)",
          "description": "Tech Lead audit of tech stack, database schema, and API contracts",
          "required_action": "eng_arch_audit",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "15m"
        }
      ]
    },
    {
      "id": "project_planning",
      "name": "Project Planning",
      "description": "Plan development work into epics and tickets",
      "entry_condition": "architecture_defined",
      "exit_condition": "planning_complete",
      "skippable": false,
      "steps": [
        {
          "id": "epic_generation",
          "name": "Generate Epics",
          "description": "Generate development epics from requirements",
          "required_action": "generate_epics",
          "user_input_required": false,
          "next_step": "epic_review",
          "estimated_duration": "15m"
        },
        {
          "id": "epic_review",
          "name": "Review Epics",
          "description": "User validates and approves epics",
          "required_action": "review_epics",
          "user_input_required": false,
          "next_step": "ticket_generation",
          "estimated_duration": "user_dependent"
        },
        {
          "id": "ticket_generation",
          "name": "Generate Tickets",
          "description": "Break epics into development tickets",
          "required_action": "generate_tickets",
          "user_input_required": false,
          "next_step": "ticket_validation",
          "estimated_duration": "20m"
        },
        {
          "id": "ticket_validation",
          "name": "Validate Tickets",
          "description": "Check ticket completeness and dependencies",
          "required_action": "validate_tickets",
          "user_input_required": false,
          "next_step": "project_timeline_generation",
          "estimated_duration": "5m"
        },
        {
          "id": "project_timeline_generation",
          "name": "Generate Project Timeline",
          "description": "Generate development timeline and roadmap",
          "required_action": "generate_project_timeline",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "5m"
        }
      ]
    },
    {
      "id": "development",
      "name": "Development",
      "description": "Feature implementation phase",
      "entry_condition": "planning_complete",
      "exit_condition": "development_complete",
      "skippable": false,
      "steps": [
        {
          "id": "swarm_tickets",
