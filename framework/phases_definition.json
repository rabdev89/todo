          "user_input_required": false,
          "next_step": "epic_validation",
          "estimated_duration": "variable"
        },
        {
          "id": "epic_validation",
          "name": "Validate Epic Completion",
          "description": "Confirm epic completion and quality gates",
          "required_action": "validate_epic",
          "user_input_required": false,
          "next_step": "eng_epic_audit",
          "estimated_duration": "10m"
        },
        {
          "id": "eng_epic_audit",
          "name": "Harden Epic Architecture (Eng Mode)",
