          "id": "error_tracking_setup",
          "name": "Setup Error Tracking",
          "description": "Configure error tracking and alerts",
          "required_action": "setup_error_tracking",
          "user_input_required": false,
          "next_step": "performance_monitoring",
          "estimated_duration": "30m"
        },
        {
          "id": "performance_monitoring",
          "name": "Monitor Performance",
          "description": "Start performance monitoring and alerting",
          "required_action": "monitor_performance",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "ongoing"
        }
      ]
