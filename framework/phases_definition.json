        },
        {
          "id": "uat_bug_fix_cycle",
          "name": "UAT Bug Fix Cycle",
          "description": "Fix issues discovered during UAT",
          "required_action": "fix_uat_bugs",
          "user_input_required": false,
          "next_step": null,
          "estimated_duration": "variable"
