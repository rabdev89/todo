    {
      "id": "ab9e3c28821541a4",
      "fileId": "82d612aceda8d959",
      "name": "isRegisterPasswordValid",
      "type": "function",
      "lineStart": 19,
      "lineEnd": 21,
      "signature": "function isRegisterPasswordValid(password: string): boolean {\n  return REGISTER_PASSWORD_PATTERN.test(password)\n}",
      "isExported": false
    }
